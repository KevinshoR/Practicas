{
  "name": "Antifraude v2 - simulador con plazo de 3 minutos",
  "nodes": [
    {
      "id": "nodo-1",
      "name": "Simular solicitud",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {},
      "position": [
        0,
        0
      ]
    },
    {
      "id": "nodo-2",
      "name": "Webhook Sumas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "correo-monitoreo",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        0,
        220
      ],
      "webhookId": "correo-monitoreo-sumas-v2"
    },
    {
      "id": "nodo-3",
      "name": "Preparar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const entrada = $input.first().json;\nconst origen = entrada.body ?? entrada;\nconst manual = Object.keys(origen).length === 0;\nconst ahora = new Date().toISOString();\nconst demo = {\n  cedula: '1001001001', transactionId: `TXN-MANUAL-${Date.now()}`,\n  valorCredito: 450000, creCredito: 'CRE-MANUAL', solicitudTomadaEn: ahora,\n};\nconst texto = String(origen.text ?? '').replace(/\\\\n/g, '\\n');\nconst extraido = origen.datosExtraidos ?? {};\nconst captura = (regex) => (texto.match(regex) ?? [])[1];\nconst montoTexto = captura(/Valor Cr[ée]dito:\\s*\\$?([0-9.]+)/i);\nconst solicitud = manual ? demo : {\n  cedula: extraido.cedula ?? origen.cedula ?? captura(/C[ée]dula:\\s*(\\d+)/i),\n  transactionId: extraido.transactionId ?? origen.transactionId ?? captura(/Transacci[óo]n:\\s*([A-Za-z0-9_-]+)/i),\n  valorCredito: extraido.valorCredito ?? origen.valorCredito ?? (montoTexto ? Number(montoTexto.replace(/\\./g, '')) : undefined),\n  creCredito: extraido.creCredito ?? origen.creCredito ?? captura(/CRE Cr[ée]dito:\\s*([A-Za-z0-9_-]+)/i) ?? '',\n  solicitudTomadaEn: extraido.solicitudTomadaEn ?? origen.solicitudTomadaEn ?? origen.fecha,\n};\nconst proceso = origen.proceso ?? 'monitoreo';\nif (!['monitoreo', 'onboarding', 'cambio_datos'].includes(proceso)) throw new Error('Proceso inválido');\nif (!solicitud.cedula || !solicitud.transactionId) throw new Error('Falta cédula o transacción');\nif (typeof solicitud.valorCredito !== 'number' || !Number.isFinite(solicitud.valorCredito) || solicitud.valorCredito < 0) throw new Error('Monto inválido');\nif (!solicitud.solicitudTomadaEn || !Number.isFinite(Date.parse(solicitud.solicitudTomadaEn))) {\n  throw new Error('Falta hora ORIGINAL de toma de solicitud. No reemplazar por hora de recepción del correo.');\n}\nreturn [{ json: { ...solicitud, cedula: String(solicitud.cedula), transactionId: String(solicitud.transactionId), proceso, esReintento: false } }];"
      },
      "position": [
        240,
        100
      ]
    },
    {
      "id": "nodo-4",
      "name": "Consultar motor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://[::1]:3000/decision/solicitud/' + $('Preparar solicitud').item.json.proceso }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ...$json, esReintento: false } }}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        500,
        100
      ]
    },
    {
      "id": "nodo-5",
      "name": "Requiere reconsulta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.pendienteConsulta === true && !$json.duplicado }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        740,
        100
      ]
    },
    {
      "id": "nodo-6",
      "name": "Esperar reconsulta",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": "={{ Math.max(1, Math.ceil($json.reintentarEnMs / 1000)) }}",
        "unit": "seconds"
      },
      "position": [
        960,
        0
      ],
      "notesInFlow": true,
      "notes": "Una sola reconsulta, normalmente a los 10 segundos. Nunca cambiar a cinco minutos. La hora original se conserva."
    },
    {
      "id": "nodo-7",
      "name": "Reconsultar una vez",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://[::1]:3000/decision/solicitud/' + $('Preparar solicitud').item.json.proceso }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { ...$('Preparar solicitud').item.json, esReintento: true } }}",
        "options": {
          "timeout": 30000
        }
      },
      "position": [
        1180,
        0
      ]
    },
    {
      "id": "nodo-8",
      "name": "Resultado",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "PASA",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "PASA"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "BLOQUEA",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BLOQUEA"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "ALERTA_HUMANA",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "ALERTA_HUMANA"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "position": [
        1420,
        120
      ]
    },
    {
      "id": "nodo-9",
