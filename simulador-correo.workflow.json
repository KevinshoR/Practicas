{
  "name": "Simulador Correo Monitoreo Antifraude - Sumas",
  "nodes": [
    {
      "parameters": {},
      "id": "1a111111-1111-4111-8111-111111111111",
      "name": "Simular Llegada de Correo",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 220]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "correo-monitoreo",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1b222222-2222-4222-8222-222222222222",
      "name": "Webhook Disparador Sumas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [220, 420],
      "webhookId": "correo-monitoreo-sumas"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "asig-subject",
              "name": "subject",
              "value": "={{ $json.body?.subject \vert{}\vert{} $json.subject || 'Alerta de Monitoreo Transaccional - Crédito CRE-9001 - Tx TXN-MANUAL-001' }}",
              "type": "string"
            },
            {
              "id": "asig-text",
              "name": "text",
              "value": "={{ $json.body?.text \vert{}\vert{} $json.text || 'Notificación automática del Disparador Transaccional Sumas:\\nCédula: 1001001001\\nTransacción: TXN-MANUAL-001\\nValor Crédito: 450000\\nCRE Crédito: CRE-9001' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2a333333-3333-4333-8333-333333333333",
      "name": "Correo de Entrada",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-asunto",
              "leftValue": "={{ $json.subject }}",
              "rightValue": "Alerta de Monitoreo",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3a444444-4444-4444-8444-444444444444",
      "name": "Filtrar por Asunto",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 320]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ext-cedula",
              "name": "cedula",
              "value": "={{ ($json.text.match(/C[ée]dula:\\s*(\\d+)/i) || [])[1] || '' }}",
              "type": "string"
            },
            {
              "id": "ext-tx",
              "name": "transactionId",
              "value": "={{ ($json.text.match(/Transacci[óo]n:\\s*([A-Za-z0-9_-]+)/i) || [])[1] || '' }}",
              "type": "string"
            },
            {
              "id": "ext-valor",
              "name": "valorCredito",
              "value": "={{ Number((($json.text.match(/Valor Cr[ée]dito:\\s*\\$?([0-9.]+)/i) || [])[1] || '0').replace(/\\./g, '')) }}",
              "type": "number"
            },
            {
              "id": "ext-cre",
              "name": "creCredito",
              "value": "={{ ($json.text.match(/CRE Cr[ée]dito:\\s*([A-Za-z0-9_-]+)/i) || [])[1] || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "4a555555-5555-4555-8555-555555555555",
